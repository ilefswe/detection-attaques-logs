{
  "name": "Detection d'attaques - Hadoop MapReduce",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [9870, 8088],
  "portsAttributes": {
    "9870": { "label": "HDFS NameNode" },
    "8088": { "label": "YARN ResourceManager" }
  },
  "postCreateCommand": "pip install --user -q matplotlib && chmod +x scripts/*.sh"
}
